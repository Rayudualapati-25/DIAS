# Copy to `.env` for local development. Make targets load this root file and
# export its values to Node, Docker Compose, and helper scripts; `npm start` in
# backend/ reads it too.

# Backend
NODE_ENV=development
PORT=3001
JWT_SECRET=replace-with-a-long-local-development-secret
CORS_ORIGIN=http://localhost:3001
AGENCY_VAULT_DIR=backend/data/agency-vault

# DIAS runs on its own five-organization channel under its own chaincode name.
# Leave CHANNEL and CHAINCODE unset to use diaschannel/diasrecords; set them only
# to point the API at another deployment.
# CHANNEL=diaschannel
# CHAINCODE=diasrecords

# The LLM the backend calls for the auditor's advisory recommendation
# (MLX-LM OpenAI-compatible server started by `make dias-model`).
DIAS_MODEL_URL=http://127.0.0.1:8081/v1
DIAS_MODEL_TIMEOUT_MS=120000
# Off-chain review store: justifications, LLM recommendations, auditor reasons.
DIAS_REVIEW_STORE_DIR=backend/data/dias-reviews
# Identity recorded with every stored recommendation. The defaults describe the
# untuned base model; set the adapter fields when serving a fine-tuned adapter.
DIAS_MODEL_ID=qwen3-14b-4bit-untuned
DIAS_BASE_MODEL=mlx-community/Qwen3-14B-4bit
# DIAS_ADAPTER_ID=
# DIAS_ADAPTER_HASH=

# Fixed identity used for cross-organisation account lookup during local login.
AUTH_ORG=audit
AUTH_USER=sp.north

# Pinned local Fabric image versions. Override only after validating the full
# network and benchmark suite with the replacement versions.
FABRIC_VERSION=2.5.16
FABRIC_CA_VERSION=1.5.22

# Optional Docker context override. Leave unset to use the active context.
# DOCKER_CONTEXT=colima

# Local Caliper/API helper default.
API_BASE=http://localhost:3001/api

# SEAL-era settings, used only by the retired reference code under backend/src/llm
# and by `make evaluate`. The DIAS runtime does not read them.
ACCESS_POLICY_MODE=llm-only
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_SEED=42
OLLAMA_TIMEOUT_MS=45000
LLM_POLICY_URL=http://127.0.0.1:8080/v1
LLM_POLICY_MODEL=default_model
LLM_POLICY_MODEL_VERSION=qwen3-14b-seba-lora-v6
LLM_POLICY_TIMEOUT_MS=60000
LLM_POLICY_ADAPTER_HASH=5f5fba8e9e19b2c4b1a2dcd1968100a2e875dde8addd0f89ff0c9385fcd601fe
LLM_POLICY_ADAPTER_PATH=LLMxAI/experiments/llm_policy_engine/adapters/qwen3-14b-seba-lora-v6-best
LLM_POLICY_SIGNING_KEY_PATH=backend/data/llm-policy-signer-private.pem
