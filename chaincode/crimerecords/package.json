{
  "name": "crimerecords",
  "version": "1.0.0",
  "description": "Crime records access-governance chaincode: Record, Access, and Audit contracts (SEBA-XAI)",
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "nyc mocha --recursive 'test/**/*.test.js'",
    "start": "fabric-chaincode-node start"
  },
  "engineStrict": true,
  "license": "Apache-2.0",
  "dependencies": {
    "fabric-contract-api": "^2.5.4",
    "fabric-shim": "^2.5.4"
  },
  "devDependencies": {
    "chai": "^4.3.7",
    "chai-as-promised": "^7.1.1",
    "mocha": "^10.2.0",
    "nyc": "^15.1.0",
    "sinon": "^15.0.4",
    "sinon-chai": "^3.7.0"
  },
  "nyc": {
    "exclude": [
      "coverage/**",
      "test/**",
      "index.js"
    ],
    "reporter": [
      "text",
      "html"
    ],
    "check-coverage": true,
    "statements": 80,
    "branches": 80,
    "functions": 80,
    "lines": 80
  }
}
