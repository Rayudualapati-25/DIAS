        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A5563;fontSize=10;" edge="1" parent="1" source="routes" target="fab_gw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="submit / evaluate  (per-user identity)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A5563;fontSize=10;" edge="1" parent="1" source="fab_gw" target="band_fabric">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="endorse · order · validate · commit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A5563;fontSize=10;" edge="1" parent="1" source="band_fabric" target="band_chain">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A5563;fontSize=10;" edge="1" parent="1" source="cc_pol" target="engine">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="first terminal rule" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A5563;fontSize=10;" edge="1" parent="1" source="engine" target="band_rules">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="emits D + E" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A5563;fontSize=10;" edge="1" parent="1" source="engine" target="artifact">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="read back" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C8794;dashed=1;fontSize=10;" edge="1" parent="1" source="artifact" target="pipeline">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="rendered text + provenance badge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C8794;dashed=1;fontSize=10;" edge="1" parent="1" source="pipeline" target="ui_explain">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" value="grant-bound read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A5563;fontSize=10;" edge="1" parent="1" source="vault_ad" target="vault">
          <mxGeometry relative="1" as="geometry"/>
