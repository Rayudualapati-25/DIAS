        <mxCell id="e10" value="SHA-256 match vs ledger commitment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C8794;dashed=1;fontSize=10;" edge="1" parent="1" source="vault" target="band_chain">
