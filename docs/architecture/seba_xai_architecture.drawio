        <mxCell id="vault_ad" value="&lt;b&gt;storage/vault.js&lt;/b&gt;&lt;br/&gt;grant-bound retrieval,&lt;br/&gt;SHA-256 re-hash on read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7EEF6;strokeColor=#325C8E;fontSize=12;fontColor=#1B2A3A;" vertex="1" parent="1">
