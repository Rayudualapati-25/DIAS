        </mxCell>
        <mxCell id="xai_mod" value="&lt;b&gt;llm/  —  explainable-AI module&lt;/b&gt;&lt;br/&gt;explain.js  (prompt whitelist → validate → fallback)&lt;br/&gt;ollama.js  (local llama3.2:3b)   ·   template.js  (deterministic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F1F3;strokeColor=#2E7D8A;fontSize=12;fontColor=#123A40;" vertex="1" parent="1">
          <mxGeometry x="1070" y="330" width="560" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="band_fabric" value="&lt;b&gt;Hyperledger Fabric v2.5.16  ·  channel: crimechannel  ·  endorsement policy: 3 of 5 organizations&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA7B4;dashed=1;verticalAlign=top;fontStyle=1;fontSize=14;fontColor=#1B2A3A;" vertex="1" parent="1">
