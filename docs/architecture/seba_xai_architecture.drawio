        <mxCell id="cc_rec" value="recordContract" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEAF5;strokeColor=#6B4E8E;fontSize=12;fontColor=#2A1D3A;" vertex="1" parent="1">
          <mxGeometry x="730" y="838" width="300" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="cc_acc" value="accessContract" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEAF5;strokeColor=#6B4E8E;fontSize=12;fontColor=#2A1D3A;" vertex="1" parent="1">
          <mxGeometry x="90" y="906" width="300" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="cc_aud" value="auditContract" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEAF5;strokeColor=#6B4E8E;fontSize=12;fontColor=#2A1D3A;" vertex="1" parent="1">
          <mxGeometry x="410" y="906" width="300" height="56" as="geometry"/>
