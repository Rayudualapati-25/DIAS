        <mxCell id="fab_ca" value="&lt;b&gt;fabric/users.js · ca.js&lt;/b&gt;&lt;br/&gt;X.509 enrolment,&lt;br/&gt;attribute issuance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7EEF6;strokeColor=#325C8E;fontSize=12;fontColor=#1B2A3A;" vertex="1" parent="1">
