        <mxCell id="band_chain" value="&lt;b&gt;Chaincode: crimerecords (JavaScript) — six contracts&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA7B4;dashed=1;verticalAlign=top;fontStyle=1;fontSize=14;fontColor=#1B2A3A;" vertex="1" parent="1">
          <mxGeometry x="60" y="790" width="1000" height="186" as="geometry"/>
        </mxCell>
        <mxCell id="cc_gov" value="governanceContract" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEAF5;strokeColor=#6B4E8E;fontSize=12;fontColor=#2A1D3A;" vertex="1" parent="1">
