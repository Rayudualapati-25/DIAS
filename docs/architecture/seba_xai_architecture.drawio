        <mxCell id="cc_usr" value="userContract" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEAF5;strokeColor=#6B4E8E;fontSize=12;fontColor=#2A1D3A;" vertex="1" parent="1">
          <mxGeometry x="410" y="838" width="300" height="56" as="geometry"/>
