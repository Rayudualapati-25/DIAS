{
  "name": "crime-records-backend",
  "version": "1.0.0",
  "description": "REST API for the Crime Records Access Network (SEBA-XAI on Fabric)",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../.env src/server.js",
    "test": "mocha --require test/setup.unit.js 'test/**/*.unit.test.js' --timeout 30000",
    "test:unit": "mocha --require test/setup.unit.js 'test/**/*.unit.test.js' --timeout 10000",
    "test:live": "mocha test/api.live.test.js --timeout 600000"
